architecture-beta
    group server[Server]
    group worker[Worker] in server
    group postgresContainer in server
    group apiContainer in server
    group caddyContainer in server
    group lgtm in server

    service sources[Job boards]
    service scrapers[Scrapers] in worker
    service triage[Triage] in worker
    service normalize[Normalize] in worker
    service filter[Filter] in worker
    service classify[Classify] in worker
    service db[PostgreSQL] in postgresContainer
    service app[Web app] in apiContainer
    service caddy[Caddy] in caddyContainer
    service grafana[Grafana] in lgtm
    service tunnel[Cloudflare Tunnel]
    service browser[Browser]
    service anthropic[Anthropic]

    sources:R --> L:scrapers
    scrapers:R --> L:triage
    triage:R --> L:normalize
    normalize:R --> L:filter
    filter:R --> L:classify
    classify{group}:R <--> L:db
    db:R --> L:app
    app:R --> L:caddy
    caddy:R --> L:tunnel
    tunnel:R --> L:browser
    triage:B --> T:anthropic
    normalize:B --> T:anthropic
    classify:B --> T:anthropic
    app:B --> T:grafana
    classify{group}:B --> L:grafana

    align row sources scrapers triage normalize filter classify db app caddy tunnel browser
    align column normalize anthropic
